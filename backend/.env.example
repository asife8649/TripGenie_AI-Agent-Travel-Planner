# Supabase PostgreSQL connection string (never commit your real .env)
# Prefer the exact URI shown by Supabase -> Connect. Example format only:
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Generate a long random secret; do not reuse the example value.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Comma-separated exact frontend origins; localhost defaults are used if omitted.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- API provider keys (leave blank if not enabled) ----------------
# Google Cloud: enable "Places API (New)" and "Routes API". Used for
# attractions + photos, hotel names/ratings/photos, train/bus stations + times.
GOOGLE_MAPS_API_KEY=

# Flights (Ignav gives airline, flight numbers and real departure/arrival times)
FLIGHT_API_KEY=
IGNAV_API_KEY=

# OPTIONAL - live hotel nightly prices (SerpApi "Google Hotels" engine).
# Without it, hotel names come from Google Places and prices are labelled estimates.
SERPAPI_KEY=

# OPTIONAL - real Indian train timetable + class-wise fares (RapidAPI listing).
# Without it, Google Routes supplies stations/times and fares are labelled estimates.
RAIL_API_KEY=
RAIL_API_HOST=irctc1.p.rapidapi.com

# OTP email: false prints OTP in backend terminal for local development.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
